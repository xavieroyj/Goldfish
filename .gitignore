# macOS
.DS_Store
.AppleDouble
.LSOverride

# Swift Package Manager and Xcode build output
.build/
.swiftpm/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate

# Generated release artifacts
build/
*.app/
*.dSYM/

# Local logs and editor files
*.log
*.swp
*.swo

# Ignore the entire .vscode directory by default
.vscode/*

# Allow to commit specific configuration files
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json